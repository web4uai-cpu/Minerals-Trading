{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @khanij/types build && pnpm --filter @khanij/ui build && pnpm --filter @khanij/web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "devCommand": "pnpm --filter @khanij/web dev",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/web/ packages/ui/ packages/types/",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
