{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm --filter * *)",
      "Bash(npx prisma migrate dev)",
      "Bash(npx prisma migrate reset --force)",
      "Bash(npx prisma db seed)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma studio)",
      "Bash(npx prisma db pull)",
      "Bash(docker compose up -d)",
      "Bash(docker compose down)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(turbo run *)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git reset --hard)",
      "Bash(rm -rf *)",
      "Bash(npx prisma migrate reset)",
      "Bash(DROP TABLE *)",
      "Bash(DELETE FROM *)"
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
