generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum OrgType {
  BUYER
  SELLER
  TRADER
  EXPORTER
  ARBITRATION_BODY
}

enum OrgStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum UserRole {
  BUYER
  SELLER
  ARBITRATOR
  ADMIN
  REGULATOR_READONLY
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

// ─── Organizations ─────────────────────────────────────────────────────────

model Organization {
  id        String    @id @default(cuid())
  type      OrgType
  legalName String
  gstin     String?   // AES-256-GCM encrypted at rest
  pan       String?   // AES-256-GCM encrypted at rest
  state     String
  status    OrgStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users              User[]
  refreshTokens      RefreshToken[]
  complianceItems    ComplianceItem[]
  complianceSnapshots ComplianceSnapshot[]
  listings           Listing[]
  rfqs               Rfq[]
  sellerQuotes       Quote[]        @relation("QuoteSellerOrg")
  buyerDeals         Deal[]         @relation("DealBuyerOrg")
  sellerDeals        Deal[]         @relation("DealSellerOrg")
  auctions           Auction[]

  @@map("organizations")
}

// ─── Users ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  orgId        String
  email        String     @unique
  phone        String?    // AES-256-GCM encrypted at rest
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org           Organization  @relation(fields: [orgId], references: [id])
  refreshTokens RefreshToken[]

  @@index([orgId])
  @@map("users")
}

// ─── Refresh Tokens ────────────────────────────────────────────────────────

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  orgId             String
  tokenHash         String    @unique // SHA-256 of the raw token
  deviceFingerprint String?
  isRevoked         Boolean   @default(false)
  expiresAt         DateTime
  replacedById      String?   // points to the successor token in a rotation chain
  createdAt         DateTime  @default(now())

  user User         @relation(fields: [userId], references: [id])
  org  Organization @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Audit Log ─────────────────────────────────────────────────────────────
// Append-only. No DELETE policy. Every state-changing action writes a row.

model AuditLog {
  id         String   @id @default(cuid())
  actor      String   // userId or "system"
  actorOrgId String?
  action     String   // e.g. "auth.login", "listing.created"
  entityType String?
  entityId   String?
  beforeHash String?  // SHA-256 of serialised before-state
  afterHash  String?  // SHA-256 of serialised after-state
  ip         String?
  traceId    String?
  createdAt  DateTime @default(now())

  @@index([actor])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Compliance Items ──────────────────────────────────────────────────────
// Tracks each required document/attestation per organization.
// Status transitions: MISSING→UPLOADED→UNDER_REVIEW→VERIFIED|REJECTED, VERIFIED→EXPIRED

enum ComplianceItemType {
  MINING_LEASE
  ENV_CLEARANCE
  FOREST_CLEARANCE
  IBM_RETURNS
  ROYALTY_CLEARANCE
  SPCB_NOC
  GST_REG
  PAN
  BANK_VERIFICATION
  IEC
  END_USE_DECLARATION
  INDUSTRY_REGISTRATION
}

enum ComplianceItemStatus {
  MISSING
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

model ComplianceItem {
  id            String               @id @default(cuid())
  orgId         String
  type          ComplianceItemType
  status        ComplianceItemStatus @default(MISSING)
  documentRef   String?              // S3 key
  validFrom     DateTime?
  validUntil    DateTime?
  verifiedBy    String?              // userId of admin who verified
  verifiedAt    DateTime?
  rejectionNote String?
  uploadedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, type])
  @@index([orgId])
  @@index([status])
  @@map("compliance_items")
}

// ─── Compliance Snapshots ──────────────────────────────────────────────────
// Append-only TrustScore history. Never overwrite, always append.
// Compliance data is the product.

model ComplianceSnapshot {
  id          String   @id @default(cuid())
  orgId       String
  trustScore  Int      // 0–100
  breakdown   Json     // { itemType: { weight, status, effectiveWeight, decayFactor } }
  triggeredBy String   // "upload" | "verify" | "reject" | "expire" | "nightly_sweep"
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("compliance_snapshots")
}

// ─── Listing Status ────────────────────────────────────────────────────────

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
}

// ─── Minerals (Catalog) ────────────────────────────────────────────────────

model Mineral {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  hsnCode     String?
  defaultUnit String   @default("MT")   // MT | KG
  gradeParams Json     // JSON schema: { "Fe%": { min: 0, max: 100 }, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings Listing[]
  rfqs     Rfq[]
  auctions Auction[]

  @@map("minerals")
}

// ─── Listings ──────────────────────────────────────────────────────────────
// A listing can only be ACTIVE if the seller org is VERIFIED.
// Every ACTIVE listing is indexed into Elasticsearch on write.

model Listing {
  id                String        @id @default(uuid())
  sellerOrgId       String
  mineralId         String
  grade             Json          // { "Fe%": 62.5, "moisture%": 4.2, ... }
  quantityAvailable Decimal       @db.Decimal(12, 2)
  unit              String        @default("MT")
  askPriceInPaise   BigInt
  location          Json          // { district, state, lat?, lng? }
  dispatchLeadDays  Int
  status            ListingStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sellerOrg Organization @relation(fields: [sellerOrgId], references: [id])
  mineral   Mineral      @relation(fields: [mineralId], references: [id])

  @@index([sellerOrgId])
  @@index([mineralId])
  @@index([status])
  @@map("listings")
}

// ─── RFQ / Quote Enums ────────────────────────────────────────────────────

enum RfqStatus {
  OPEN
  QUOTED
  CLOSED
  CANCELLED
}

enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// ─── Deal Enums ───────────────────────────────────────────────────────────

enum DealStatus {
  CREATED
  AGREEMENT_DRAFT
  SIGNED
  ESCROW_PENDING
  IN_FULFILMENT
  COMPLETED
  DISPUTED
  CANCELLED
}

enum MilestoneType {
  AGREEMENT
  ESCROW
  SAMPLING
  DISPATCH
  DELIVERY
  PAYMENT
}

enum MilestoneStatus {
  PENDING
  DONE
  OVERDUE
}

enum EscrowEntryType {
  HELD
  RELEASED
  REFUNDED
}

enum MessageSenderType {
  BUYER
  SELLER
  AI
}

// ─── RFQ ──────────────────────────────────────────────────────────────────
// A buyer's Request For Quote for a specific mineral + grade.

model Rfq {
  id         String    @id @default(uuid())
  buyerOrgId String
  listingId  String?   // optional — can reference a specific listing
  mineralId  String
  grade      Json      // { "Fe%": 62, ... }
  quantity   Decimal   @db.Decimal(12, 2)
  unit       String    @default("MT")
  neededBy   DateTime
  notes      String?
  status     RfqStatus @default(OPEN)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  buyerOrg Organization @relation(fields: [buyerOrgId], references: [id])
  mineral  Mineral      @relation(fields: [mineralId], references: [id])
  quotes   Quote[]

  @@index([buyerOrgId])
  @@index([mineralId])
  @@index([status])
  @@map("rfqs")
}

// ─── Quote ────────────────────────────────────────────────────────────────
// A seller's response to an RFQ with pricing and terms.

model Quote {
  id               String      @id @default(uuid())
  rfqId            String
  sellerOrgId      String
  pricePerUnitPaise BigInt
  validUntil       DateTime
  terms            Json?       // arbitrary terms JSON
  status           QuoteStatus @default(SENT)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  rfq       Rfq          @relation(fields: [rfqId], references: [id])
  sellerOrg Organization @relation("QuoteSellerOrg", fields: [sellerOrgId], references: [id])
  deals     Deal[]

  @@index([rfqId])
  @@index([sellerOrgId])
  @@index([status])
  @@map("quotes")
}

// ─── Deal ─────────────────────────────────────────────────────────────────
// Created when a buyer accepts a quote. State machine enforced in code.
// A Deal cannot reach SIGNED if either party's org is not VERIFIED.

model Deal {
  id               String     @id @default(uuid())
  buyerOrgId       String
  sellerOrgId      String
  quoteId          String
  mineralId        String
  grade            Json
  quantity         Decimal    @db.Decimal(12, 2)
  unit             String     @default("MT")
  totalValuePaise  BigInt
  arbitrationSeat  String?    // city/state for arbitration jurisdiction
  status           DealStatus @default(CREATED)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  buyerOrg   Organization   @relation("DealBuyerOrg", fields: [buyerOrgId], references: [id])
  sellerOrg  Organization   @relation("DealSellerOrg", fields: [sellerOrgId], references: [id])
  quote      Quote          @relation(fields: [quoteId], references: [id])
  milestones         DealMilestone[]
  escrow             EscrowLedger[]
  messages           DealMessage[]
  shipments          Shipment[]
  disputes           Dispute[]
  tradeApplications       TradeApplication[]
  crossBorderSettlements  CrossBorderSettlement[]

  @@index([buyerOrgId])
  @@index([sellerOrgId])
  @@index([quoteId])
  @@index([status])
  @@map("deals")
}

// ─── Deal Milestones ──────────────────────────────────────────────────────
// Default 6 milestones created on deal creation.

model DealMilestone {
  id          String          @id @default(uuid())
  dealId      String
  type        MilestoneType
  sequence    Int             // 1-6 ordering
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  deal Deal @relation(fields: [dealId], references: [id])

  @@unique([dealId, type])
  @@index([dealId])
  @@map("deal_milestones")
}

// ─── Escrow Ledger ────────────────────────────────────────────────────────
// Append-only. Every entry references a PaymentProvider txn ref.
// Balance = Σ HELD - Σ RELEASED - Σ REFUNDED

model EscrowLedger {
  id          String          @id @default(uuid())
  dealId      String
  type        EscrowEntryType
  amountPaise BigInt
  txnRef      String          // PaymentProvider transaction reference
  note        String?
  createdAt   DateTime        @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId])
  @@map("escrow_ledger")
}

// ─── Deal Messages ────────────────────────────────────────────────────────
// Persisted deal-room chat. Real-time via WebSocket + Redis pub/sub.

model DealMessage {
  id            String            @id @default(uuid())
  dealId        String
  senderType    MessageSenderType
  senderOrgId   String?           // null for AI messages
  senderUserId  String?
  content       String
  createdAt     DateTime          @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@index([dealId, createdAt])
  @@map("deal_messages")
}

// ─── Auction / Bidding ────────────────────────────────────────────────────
// Separate price-discovery channel alongside RFQ/Quote.

enum AuctionStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  AWARDED
}

enum AuctionType {
  FORWARD        // seller auctions, highest bidder wins
  REVERSE        // buyer auctions, lowest bidder wins
}

model Auction {
  id                String        @id @default(uuid())
  creatorOrgId      String
  type              AuctionType
  mineralId         String
  grade             Json          // { "Fe%": 62, ... }
  quantity          Decimal       @db.Decimal(12, 2)
  unit              String        @default("MT")
  reservePriceInPaise BigInt?     // minimum acceptable (forward) or max budget (reverse)
  startAt           DateTime
  endAt             DateTime
  antiSnipingMinutes Int          @default(5) // extend endAt if bid in last N minutes
  minIncrementPaise BigInt        @default(100) // minimum bid increment
  status            AuctionStatus @default(DRAFT)
  winningBidId      String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  creatorOrg Organization @relation(fields: [creatorOrgId], references: [id])
  mineral    Mineral      @relation(fields: [mineralId], references: [id])
  bids       Bid[]
  winningBid Bid?         @relation("WinningBid", fields: [winningBidId], references: [id])

  @@index([creatorOrgId])
  @@index([mineralId])
  @@index([status])
  @@index([endAt])
  @@map("auctions")
}

model Bid {
  id             String   @id @default(uuid())
  auctionId      String
  bidderOrgId    String
  bidderUserId   String
  amountPaise    BigInt
  createdAt      DateTime @default(now())

  auction    Auction @relation(fields: [auctionId], references: [id])
  wonAuction Auction? @relation("WinningBid")

  @@index([auctionId, createdAt])
  @@index([bidderOrgId])
  @@map("bids")
}

// ─── Invoice ──────────────────────────────────────────────────────────────
// Generated when deal reaches COMPLETED. Tax-compliant with GST breakdown.

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model Invoice {
  id              String        @id @default(uuid())
  dealId          String
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  sellerOrgId     String
  buyerOrgId      String
  subtotalPaise   BigInt
  igstPaise       BigInt        @default(0)
  cgstPaise       BigInt        @default(0)
  sgstPaise       BigInt        @default(0)
  totalTaxPaise   BigInt
  grandTotalPaise BigInt
  lineItems       Json          // InvoiceLineItem[]
  gstRate         Float
  isInterstate    Boolean
  issuedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([dealId])
  @@index([sellerOrgId])
  @@index([buyerOrgId])
  @@map("invoices")
}

// ─── Shipment / Logistics ─────────────────────────────────────────────────
// Physical movement of goods tied to a deal.

enum ShipmentStatus {
  CREATED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CONFIRMED
  CANCELLED
}

enum TrackingEventType {
  PICKUP
  CHECKPOINT
  CUSTOMS
  EXCEPTION
  DELIVERED
  WEIGHT_VERIFIED
}

model Shipment {
  id                    String         @id @default(uuid())
  dealId                String
  sellerOrgId           String
  buyerOrgId            String
  carrierName           String
  vehicleNumber         String
  driverName            String?
  driverPhone           String?        // encrypted if real
  originDistrict        String
  originState           String
  destinationDistrict   String
  destinationState      String
  estimatedDeliveryDate DateTime
  weightAtOriginKg      Float?
  weightAtDestinationKg Float?
  status                ShipmentStatus @default(CREATED)
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  confirmedAt           DateTime?
  confirmedByUserId     String?
  receivedByName        String?
  receivedByPhone       String?
  proofDocumentRef      String?        // S3 key for proof of delivery
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  deal           Deal            @relation(fields: [dealId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([dealId])
  @@index([sellerOrgId])
  @@index([buyerOrgId])
  @@index([status])
  @@map("shipments")
}

model TrackingEvent {
  id          String            @id @default(uuid())
  shipmentId  String
  eventType   TrackingEventType
  location    String
  notes       String?
  weightKg    Float?
  recordedBy  String            // userId
  createdAt   DateTime          @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, createdAt])
  @@map("tracking_events")
}

// ─── Arbitration ──────────────────────────────────────────────────────────
// Dispute resolution with structured evidence and enforceable awards.

enum DisputeCategory {
  QUALITY
  QUANTITY
  PAYMENT
  DELIVERY
  OTHER
}

enum DisputeStatus {
  FILED
  UNDER_REVIEW
  HEARING
  AWARD_ISSUED
  CLOSED
  WITHDRAWN
}

model Dispute {
  id           String          @id @default(uuid())
  dealId       String
  filedByOrgId String
  filedByUserId String
  category     DisputeCategory
  description  String
  status       DisputeStatus   @default(FILED)
  assignedArbitratorId String?
  filedAt      DateTime        @default(now())
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  deal      Deal       @relation(fields: [dealId], references: [id])
  evidence  Evidence[]
  award     Award?

  @@index([dealId])
  @@index([filedByOrgId])
  @@index([status])
  @@map("disputes")
}

model Evidence {
  id           String   @id @default(uuid())
  disputeId    String
  submittedByOrgId String
  submittedByUserId String
  type         String   // "document", "testimony", "photo", "weight_slip"
  title        String
  description  String?
  documentRef  String?  // S3 key
  createdAt    DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId])
  @@map("evidence")
}

model Award {
  id           String   @id @default(uuid())
  disputeId    String   @unique
  arbitratorId String
  decision     Json     // { ruling, rationale, escrowAction, amountPaise? }
  isAiDrafted  Boolean  @default(false)
  awardedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@map("awards")
}

// ─── Blockchain Anchoring ─────────────────────────────────────────────────
// Hash anchors for audit trail tamper-evidence. No-op provider in MVP.

model AuditAnchor {
  id                 String   @id @default(uuid())
  entityType         String
  entityId           String
  contentHash        String
  anchorHash         String   @unique
  previousAnchorHash String?
  chainId            String?  // blockchain network identifier (null for no-op provider)
  txHash             String?  // blockchain transaction hash (null for no-op provider)
  anchoredAt         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([anchoredAt])
  @@map("audit_anchors")
}

// ─── International Trade ──────────────────────────────────────────────────
// Cross-border trade applications with export/import clearance tracking.

enum TradeDirection {
  EXPORT
  IMPORT
}

enum ExportClearanceStatus {
  PENDING
  APPLIED
  APPROVED
  REJECTED
  EXPIRED
}

model TradeApplication {
  id                  String                @id @default(uuid())
  dealId              String
  applicantOrgId      String
  direction           TradeDirection
  destinationCountry      String
  destinationCountryCode  String                @db.Char(2)
  portOfLoading           String
  portOfDischarge     String
  mineralName         String
  hsnCode             String
  quantityMt          Decimal               @db.Decimal(12, 2)
  valueFobPaise       BigInt
  iecNumber           String?
  clearanceStatus     ExportClearanceStatus  @default(PENDING)
  dgftRefNumber       String?               // DGFT reference after application
  appliedAt           DateTime?
  approvedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  validUntil          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  deal        Deal                     @relation(fields: [dealId], references: [id])
  settlements CrossBorderSettlement[]

  @@index([dealId])
  @@index([applicantOrgId])
  @@index([clearanceStatus])
  @@map("trade_applications")
}

// ─── Cross-Border Settlement ──────────────────────────────────────────────
// Tracks forex and payment for international trade applications.
// Real money movement is via PaymentProvider stub — this models the ledger.

enum SettlementCurrency {
  INR
  USD
  EUR
  GBP
  JPY
  AED
  SGD
  AUD
}

enum CrossBorderSettlementStatus {
  PENDING_FOREX
  FOREX_LOCKED
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  SETTLED
  FAILED
}

model CrossBorderSettlement {
  id                    String                       @id @default(uuid())
  tradeApplicationId    String
  dealId                String
  sourceCurrency        SettlementCurrency
  targetCurrency        SettlementCurrency
  amountSourcePaise     BigInt
  amountTargetPaise     BigInt?
  forexRateSnapshot     Decimal                      @db.Decimal(18, 8)
  forexLockedAt         DateTime?
  forexExpiresAt        DateTime?
  bankSwiftCode         String
  beneficiaryAccountRef String
  status                CrossBorderSettlementStatus  @default(PENDING_FOREX)
  paymentRef            String?
  settledAt             DateTime?
  failureReason         String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  tradeApplication TradeApplication @relation(fields: [tradeApplicationId], references: [id])
  deal             Deal             @relation(fields: [dealId], references: [id])

  @@index([tradeApplicationId])
  @@index([dealId])
  @@index([status])
  @@map("cross_border_settlements")
}
