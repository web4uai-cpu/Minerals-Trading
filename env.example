# ─────────────────────────────────────────────────────────────
# KHANIJ NEXUS — environment template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- PostgreSQL (+ TimescaleDB) ---
DATABASE_URL=postgresql://khanij:khanij@localhost:5432/khanij?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/khanij

# --- S3 / MinIO (object storage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=khanij-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-different-strong-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Field-level encryption (PII at rest) ---
# 32-byte key, base64. Generate: openssl rand -base64 32
PII_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# --- Anthropic / Claude (AiService) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
AI_MODEL=claude-sonnet-4-5
AI_MAX_TOKENS=2000

# --- Providers (sandbox in dev; real integrations gated by licence) ---
KYC_PROVIDER=sandbox            # sandbox | uidai | nsdl
GOV_DATA_PROVIDER=sandbox       # sandbox | ibm | state-directorate
PRICE_FEED_PROVIDER=sandbox     # sandbox | lme | mcx
PAYMENT_PROVIDER=sandbox        # sandbox ONLY until RBI PA/PA-C licence
DOCUMENT_AI_PROVIDER=sandbox    # sandbox | textract

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Observability ---
LOG_LEVEL=info                  # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Notifications (scaffold) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PUSH_PROVIDER=                  # expo | fcm
